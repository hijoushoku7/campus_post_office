# ---- アプリ ----
# 公開URL（Cloudflare Tunnel で割り当てた独自ドメイン）
PUBLIC_BASE_URL=https://files.example.com
# Auth.js セッション署名鍵（`openssl rand -base64 32` 等で生成）
AUTH_SECRET=change-me-to-a-long-random-string
# Auth.js の信頼ホスト（リバースプロキシ/トンネル配下のため true）
AUTH_TRUST_HOST=true

# ---- データベース ----
DATABASE_URL=postgresql://app:app_password@postgres:5432/campus_post_office?schema=public
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=campus_post_office

# ---- Redis / キュー ----
REDIS_URL=redis://redis:6379

# ---- ストレージ ----
# ファイル本体の保存先（コンテナ内パス。compose でボリュームをマウント）
UPLOAD_DIR=/data/uploads
# 1ファイルの上限（バイト）。アプリのハード上限は10GiB
MAX_FILE_SIZE=10737418240
# 既定の有効期限（日）
DEFAULT_EXPIRY_DAYS=7
# クライアントのチャンクサイズ（バイト）Cloudflare 100MB制約のため 50MB
UPLOAD_CHUNK_SIZE=52428800
# アップロード受理に必要な最低空き容量（バイト）デフォルト 20GB
MIN_FREE_SPACE=21474836480

# ---- ClamAV ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- cloudflared ----
# Cloudflare ダッシュボードで発行した Tunnel トークン
TUNNEL_TOKEN=change-me

# ---- 初期管理者（seed 実行時に作成） ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
